# Set these in the process environment. Django does not auto-load this file.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Required with DEBUG=false. Generate a unique key for each deployment.
DJANGO_SECRET_KEY=
# Production HTTPS hostname(s), without schemes, go in DJANGO_ALLOWED_HOSTS.
# Include schemes in CSRF origins. Empty is fine for a same-origin local app.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-host.example
# Enable only if the hosting reverse proxy strips and sets X-Forwarded-Proto.
DJANGO_TRUST_PROXY=false
# Optional absolute paths on persistent storage (defaults remain inside project):
# DJANGO_DB_PATH=/var/data/nk-food/db.sqlite3
# DJANGO_MEDIA_DIR=/var/data/nk-food/media
# Optional PostgreSQL (install psycopg[binary] separately):
# DB_ENGINE=postgresql
# DB_NAME=nk_foodcourt
# DB_USER=nk_foodcourt
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
